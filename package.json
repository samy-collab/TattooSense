{
  "name": "tattoosense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace shared && npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "prisma:seed": "tsx database/prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prisma": {
    "seed": "tsx database/prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
